# Gmail API OAuth Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
SENDER_NAME=Your Name
SENDER_EMAIL=your_email@gmail.com

# Daily limits & Safety
DAILY_SEND_LIMIT=50
WARMUP_MODE=true
WARMUP_DAILY_LIMIT=10

# API Keys (Optional fallbacks)
HUNTER_API_KEY=
PROSPEO_API_KEY=
MILLION_VERIFIER_API_KEY=
OUTSCRAPER_API_KEY=
FOURSQUARE_API_KEY=
YOUTUBE_API_KEY=

# Database
DB_PATH=outreach.db

# Mailbox lists (comma separated). Kept here, not in code, because the repository is public.
AUTHOR_INBOXES=
DISABLED_INBOXES=

# Only for the PC/server autopilot (autopilot_local.py). Leave false while GitHub Actions is sending,
# or the same leads get emailed twice from two different databases.
LOCAL_AUTOPILOT_SENDS=false
